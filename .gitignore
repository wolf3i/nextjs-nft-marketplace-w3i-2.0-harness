# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# vscode
.vscode/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
# ✅ Commit: .env (team defaults), .env*.template (setup guides)
# 🔒 NEVER commit: .env.local, .env*.local (contain secrets!)
.env.local
.env*.local
.env-old/

# Persönliche Freigaben — trägt Freigaben, die nie reviewt werden.
# MUSS ignoriert bleiben (siehe SETUP.md Punkt 7 / Befund G10).
.claude/settings.local.json

# Aufgaben-Gedächtnis — bewusst nicht committet, nur die Vorlage bleibt
# getrackt (state/zwischenstand/VORLAGE.md via Ausnahme unten).
state/zwischenstand/*.md
!state/zwischenstand/VORLAGE.md

# Einmal-Freigabe für den Commit-Guard (.claude/hooks/commit-guard.js) —
# ephemer, ein personenbezogener Freigabe-Vorgang für genau einen Commit.
# Nie committen: Läge sie im Repo, wäre sie kein zweiter Schlüssel mehr.
state/freigabe-commit.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary files
*.tmp
*.temp
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo
*~
next-env.d.ts

# runtime caches
/public/cached-nft-images/

# Logs
*.log
sync-service-debug.log

# Build outputs & debug files
build-*.txt
build-*.log
api_response*.json
api_routes*.json

# Temp files
temp-*
*.tmp
*.temp

